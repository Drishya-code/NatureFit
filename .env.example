# NatureFit Environment Variables
# Copy this file to .env.local and fill in your values

# Open-weight AI API Configuration (optional - app works with fallback generator)
# For OpenRouter (recommended for free models):
VITE_AI_API_URL=https://openrouter.ai/api/v1/chat/completions
VITE_AI_API_KEY=your_openrouter_api_key_here
VITE_AI_MODEL=google/gemma-2-9b-it:free

# Alternative: Local Ollama (if running locally)
# VITE_AI_API_URL=http://localhost:11434/v1/chat/completions
# VITE_AI_API_KEY=ollama
# VITE_AI_MODEL=gemma2:2b

# Alternative: BharatCode (free tier: qwen-3.8-27b)
# VITE_AI_API_URL=https://bharatcode.ai/api/model/v1/chat/completions
# VITE_AI_API_KEY=bc_live_your_key_here
# VITE_AI_MODEL=qwen-3.8-27b